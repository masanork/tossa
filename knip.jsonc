{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/db/queries.ts",
        "src/types.ts",
        "src/routes/seo.ts",
        "e2e/**/*.spec.ts",
      ],
    },
    "web": {
      "entry": [
        "src/lib/api.ts",
        "src/lib/e2ee.ts",
        "src/lib/modalManager.svelte.ts",
        "public/sw.js",
      ],
    },
  },
  // Pre-existing unused dependency on main — exifr is used via dynamic import in media-processor.ts
  "ignoreDependencies": ["exifr"],
  // Pre-existing unused files on main — loaded dynamically via modalManager / App.svelte
  "ignoreFiles": [
    "web/src/lib/AdminModal.svelte",
    "web/src/lib/CreatePostModal.svelte",
    "web/src/lib/HelpModal.svelte",
    "web/src/lib/MapView.svelte",
    "web/src/lib/media-processor.ts",
    "web/src/lib/MessagesModal.svelte",
    "web/src/lib/municipalityCodes.ts",
    "web/src/lib/MyPageModal.svelte",
    "web/src/lib/OfflineMapModal.svelte",
    "web/src/lib/PrintSheetModal.svelte",
    "web/src/lib/PushModal.svelte",
    "web/src/lib/QrCodeModal.svelte",
    "web/src/lib/QrScannerModal.svelte",
    "web/src/lib/swipeToDismiss.ts",
    "web/src/lib/UpdateStatusModal.svelte",
  ],
  // Pre-existing unused exports/types on main — suppress per-file
  "ignoreIssues": {
    "src/middleware/deviceCookie.ts": ["exports"],
    "src/routes/opendata.ts": ["exports", "types"],
    "src/services/backup.ts": ["exports", "types"],
    "src/services/emailVerify.ts": ["exports"],
    "src/services/feedSnapshot.ts": ["exports"],
    "src/services/capacity.ts": ["types"],
    "src/utils/csv.ts": ["types"],
    "web/src/lib/csvHelper.ts": ["exports", "types"],
    "web/src/lib/mapTileCache.ts": ["exports", "types"],
    "web/src/lib/seedTags.ts": ["exports"],
    "web/src/lib/tagDictionary.ts": ["exports"],
    "web/src/lib/types.ts": ["types"],
  },
}
