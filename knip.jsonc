{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "src/db/queries.ts",
        "src/types.ts",
        "src/routes/seo.ts",
        "scripts/backup-drill-worker.ts",
        "scripts/load-local-worker.ts",
        "scripts/load-cloudflare-worker.ts",
        "e2e/**/*.spec.ts",
        "test/**/*.test.ts",
        "test/fixtures/smoke-admin-fetch.mjs",
      ],
    },
    "web": {
      "entry": [
        "src/App.svelte",
        "src/lib/**/*.svelte",
        "src/lib/api.ts",
        "src/lib/e2ee.ts",
        "src/lib/modalManager.svelte.ts",
        "public/sw.js",
      ],
    },
  },
}
