{
  "name": "tossa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix web run build && node scripts/verify-offline-build.mjs",
    "build": "npm run build:web && tsc --noEmit && npm run typecheck:monitor",
    "deploy": "npm run build:web && wrangler deploy",
    "db:init:local": "wrangler d1 execute tossa-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute tossa-db --local --file=./seed.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local",
    "db:init:remote": "wrangler d1 execute tossa-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute tossa-db --remote --file=./seed.sql",
    "typecheck": "npm run build:web && tsc --noEmit && npm run typecheck:monitor && npm --prefix web run check",
    "typecheck:monitor": "tsc --noEmit -p tsconfig.monitor.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "stats": "node --experimental-strip-types scripts/stats.ts",
    "stats:save": "node --experimental-strip-types scripts/stats.ts --save stats",
    "stats:plot": "node --experimental-strip-types scripts/plot-growth.ts --update --stats-file stats/stats.json",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tail": "wrangler tail tossa",
    "backup:restore": "node scripts/restore-backup.mjs",
    "backup:drill": "node scripts/backup-drill.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "load:local": "node scripts/load-local.mjs",
    "load:cloudflare": "node scripts/load-cloudflare.mjs",
    "monitor:operations": "node scripts/monitor-operations.mjs",
    "backup:export": "node scripts/d1-export-archive.mjs",
    "backup:production-drill": "node scripts/backup-production-drill.mjs",
    "backup:scheduled-drill": "node scripts/backup-scheduled-drill.mjs",
    "monitor:deploy": "wrangler deploy --config operations-monitor.wrangler.jsonc",
    "monitor:types": "wrangler types scripts/operations-monitor-env.d.ts --config operations-monitor.wrangler.jsonc --env-interface OperationsMonitorEnv --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.17",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
