{
  "name": "tossa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix web run build",
    "build": "npm run build:web && tsc --noEmit",
    "deploy": "npm run build:web && wrangler deploy",
    "db:init:local": "wrangler d1 execute tossa-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute tossa-db --local --file=./seed.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local",
    "db:init:remote": "wrangler d1 execute tossa-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute tossa-db --remote --file=./seed.sql",
    "typecheck": "tsc --noEmit && npm --prefix web run check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "knip": "^6.35.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^3.107.3"
  }
}
