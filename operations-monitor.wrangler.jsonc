{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tossa-operations-monitor",
  "main": "scripts/operations-monitor-worker.ts",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "4b749427a0c80c547e726a42aff4b6fc",
    "HEALTH_URL": "https://tossa.app/api/health",
    "OPERATIONAL_ALERT_FROM": "noreply@tossa.app",
    "OPERATIONAL_ALERT_DRY_RUN": "false",
  },
  "r2_buckets": [
    { "binding": "BACKUPS_BUCKET", "bucket_name": "tossa-backups" },
  ],
  "kv_namespaces": [
    { "binding": "MONITOR_STATE", "id": "d9686e3cb9f5427ca0d0cc69eab905a6" },
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["noreply@tossa.app"] },
  ],
  "triggers": { "crons": ["2-57/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
